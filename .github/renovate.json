{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Europe/Zurich",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Group non-major updates into one PR and automerge once CI passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Major updates get their own PR for manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Pin the (currently unpinned) test requirements so they can be tracked",
      "matchManagers": ["pip_requirements"],
      "rangeStrategy": "pin"
    }
  ]
}
